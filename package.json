{
  "name": "elden-ring-build-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Elden Ring browser-only calculators",
  "scripts": {
    "build": "npm run test && npm run verify:ar && node scripts/build.mjs && npm run verify:deployment",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build",
    "verify:deployment": "node scripts/verify-deployment-artifact.mjs",
    "verify:ar": "node scripts/verify-ar.mjs --example",
    "import:regulation": "node scripts/import-regulation.mjs --help",
    "audit:regulation": "node scripts/audit-regulation.mjs --help",
    "audit:real-v117": "node scripts/audit-v117-pinned.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
